    "tailwindcss": "^4.3.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
