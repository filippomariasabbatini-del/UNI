---
import { site } from '../../config/site';
import Mark from '../../assets/brand/mark.svg';
import type { Locale } from '../../config/site';
import { getContent, type Ui } from '../../lib/content';
import { LAYERS } from '../../scripts/logo-stage/logo';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';

interface Props {
  locale: Locale;
  ui: Ui;
}
const { locale } = Astro.props;
const { hero } = Astro.props.ui;
const printers = site.studios.find((studio) => studio.primary)?.printers ?? null;
const [badgeBefore = '', badgeAfter = ''] = hero.liveBadge.split('{count}');
const [left, right] = hero.images;
const frame = 'rounded-panel bg-surface shadow-card overflow-hidden';
const stage = hero.logoStage;
// I nomi dei filamenti arrivano dal listino materiali: un solo posto in cui scriverli
const stageMaterials = (await getContent('materials', locale)).items.map(({ id, name }) => ({
  id,
  name,
}));
---

<section aria-labelledby="hero-title" class="overflow-hidden pt-[clamp(7rem,13vw,11rem)] pb-16">
  <Container class="text-center">
    <Eyebrow>{hero.eyebrow}</Eyebrow>
    <Heading level={1} size="display" id="hero-title" class="mx-auto mt-5 max-w-[19ch]">
      {hero.title}
    </Heading>
    <p class="text-muted mx-auto mt-7 max-w-[44rem] text-[clamp(1.125rem,0.7vw+1rem,1.375rem)] leading-[1.5]">
      {hero.sub}
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <Button href="#contatti">{hero.primaryCta}</Button>
      <Button href="#materiali" variant="secondary">
        {hero.secondaryCta}
      </Button>
    </div>
    {printers !== null && (
      <p class="bg-surface text-muted mt-8 inline-flex min-h-9 items-center gap-2.5 rounded-full px-4 text-[0.875rem]">
        <span class="live-dot bg-ok text-ok relative size-2 rounded-full" />
        <span>
          {badgeBefore}
          <span data-count-to={printers} class="text-fg font-semibold tabular-nums">
            {printers}
          </span>
          {badgeAfter}
        </span>
      </p>
    )}
  </Container>

  <Container class="mt-[clamp(3rem,6vw,5rem)]">
    <div class="grid items-end gap-5 md:grid-cols-[1fr_1.3fr_1fr]">
      {left && (
        <div class:list={[frame, 'hidden aspect-[4/5] md:block']}>
          <Photo src={left.src} alt={left.alt} sizes="(min-width: 75rem) 21rem, 28vw" parallax />
        </div>
      )}
      {/*
        Il logo statico è il contenuto di base: src/scripts/logo-stage gli sovrappone la scena 3D dove WebGL regge.
        La scheda ha proporzioni fisse: quando compaiono i controlli si restringe la scena, non si sposta la pagina.
      */}
      <div
        data-logo-stage
        data-config={JSON.stringify({ materials: stageMaterials, material: stage.defaultMaterial })}
        class:list={[frame, 'logo-stage flex aspect-[3/5] flex-col md:aspect-[3/4]']}
      >
        <div data-stage-view class="logo-stage-view relative min-h-0 flex-1">
          <Mark
            data-stage-fallback
            role="img"
            aria-label={stage.fallbackAlt}
            class="absolute inset-0 m-auto h-auto w-[56%]"
          />
          <canvas
            data-stage-canvas
            hidden
            role="img"
            aria-label={stage.label}
            class="absolute inset-0 h-full w-full"
          />
          <p
            data-stage-readout
            hidden
            aria-hidden="true"
            class="bg-raised/85 text-muted absolute top-3 left-3 rounded-full px-3 py-2 font-mono text-[0.6875rem] leading-none tabular-nums"
          >
            Z <span data-stage-z>0.00</span> mm · {stage.layer} <span data-stage-layer>00</span>/
            {LAYERS}
          </p>
          <p
            data-stage-nfc
            hidden
            aria-hidden="true"
            class="bg-fg text-bg pointer-events-none absolute inset-x-0 bottom-4 mx-auto w-max rounded-full px-3.5 py-2 font-mono text-[0.6875rem] leading-none"
          >
            {stage.nfcReady}
          </p>
          <button
            type="button"
            data-stage-toggle
            data-label-pause={stage.pause}
            data-label-play={stage.play}
            aria-label={stage.pause}
            hidden
            class="border-line bg-raised text-fg group/toggle absolute top-2 right-2 inline-flex size-11 items-center justify-center rounded-full border"
          >
            <Icon name="pause" size={18} class="group-data-paused/toggle:hidden" />
            <Icon name="play" size={18} class="hidden group-data-paused/toggle:block" />
          </button>
        </div>

        <div data-stage-controls hidden class="border-line bg-raised border-t p-3 text-left">
          <ol aria-label={stage.stepsLabel} class="grid grid-cols-4 gap-1.5">
            {stage.steps.map((step, index) => (
              <li>
                <button
                  type="button"
                  data-stage-step={index}
                  class="border-line text-muted hover:text-fg aria-[current]:border-fg aria-[current]:bg-surface aria-[current]:text-fg flex h-full min-h-13 w-full flex-col gap-1 rounded-xl border px-2 py-2 text-left text-[0.6875rem] leading-[1.15] font-medium transition-colors"
                >
                  <span class="text-accent-text font-mono">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span>{step}</span>
                </button>
              </li>
            ))}
          </ol>

          <div class="mt-2 flex items-center justify-between gap-2">
            <div role="radiogroup" aria-label={stage.material} class="-ml-2 flex">
              {stageMaterials.map((material) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked={material.id === stage.defaultMaterial ? 'true' : 'false'}
                  aria-label={material.name}
                  title={material.name}
                  data-stage-material={material.id}
                  class="group/swatch inline-flex size-11 items-center justify-center max-[23rem]:w-10"
                >
                  <span
                    class:list={[
                      `filament-${material.id}`,
                      'ring-line group-aria-checked/swatch:ring-fg ring-offset-raised size-5 rounded-full ring-1 ring-offset-2 transition-shadow group-aria-checked/swatch:ring-2',
                    ]}
                  />
                </button>
              ))}
            </div>
            <p
              data-stage-material-name
              aria-hidden="true"
              class="text-muted truncate font-mono text-[0.6875rem]"
            />
          </div>

          <button
            type="button"
            role="switch"
            aria-checked="false"
            data-stage-xray
            disabled
            class="group/switch border-line mt-1 flex min-h-11 w-full items-center justify-between gap-3 border-t pt-1 text-[0.8125rem] font-medium disabled:cursor-not-allowed disabled:opacity-50"
          >
            <span>{stage.xray}</span>
            <span class="bg-field group-aria-checked/switch:bg-accent relative h-6 w-10 shrink-0 rounded-full transition-colors">
              <span class="bg-raised absolute top-0.5 left-0.5 size-5 rounded-full transition-transform group-aria-checked/switch:translate-x-4" />
            </span>
          </button>
        </div>
      </div>
      {right && (
        <div class:list={[frame, 'hidden aspect-[4/5] md:block']}>
          <Photo src={right.src} alt={right.alt} sizes="(min-width: 75rem) 21rem, 28vw" parallax />
        </div>
      )}
    </div>

    <dl class="mx-auto mt-[clamp(3rem,6vw,5rem)] grid max-w-[56rem] gap-y-8 text-center sm:grid-cols-3">
      {hero.stats.map((stat) => (
        <div class="flex flex-col-reverse gap-1.5">
          <dt class="text-muted text-[0.9375rem]">{stat.label}</dt>
          <dd class="text-[clamp(2rem,3vw+1rem,3.25rem)] leading-none font-semibold tracking-[-0.035em] tabular-nums">
            {stat.value === null ? (
              stat.text
            ) : (
              <>
                {stat.prefix}
                <span data-count-to={stat.value}>{stat.value}</span>
                {stat.suffix}
              </>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </Container>
</section>
