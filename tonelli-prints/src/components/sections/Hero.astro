---
import { site } from '../../config/site';
import type { Locale } from '../../config/site';
import { getContent, type Ui } from '../../lib/content';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';

interface Props {
  locale: Locale;
  ui: Ui;
}
const { locale } = Astro.props;
const { hero } = Astro.props.ui;
const printers = site.studios.find((studio) => studio.primary)?.printers ?? null;
const [badgeBefore = '', badgeAfter = ''] = hero.liveBadge.split('{count}');
const [left, center, right] = hero.images;
const frame = 'rounded-panel bg-surface shadow-card overflow-hidden';
const stage = hero.printStage;
// Il nome del filamento arriva dal listino materiali: un solo posto in cui scriverlo
const materials = (await getContent('materials', locale)).items;
const stageObjects = stage.objects.map((object) => ({
  ...object,
  materialName: materials.find((material) => material.id === object.material)?.name ?? '',
}));
---

<section aria-labelledby="hero-title" class="overflow-hidden pt-[clamp(7rem,13vw,11rem)] pb-16">
  <Container class="text-center">
    <Eyebrow>{hero.eyebrow}</Eyebrow>
    <Heading level={1} size="display" id="hero-title" class="mx-auto mt-5 max-w-[19ch]">
      {hero.title}
    </Heading>
    <p class="text-muted mx-auto mt-7 max-w-[44rem] text-[clamp(1.125rem,0.7vw+1rem,1.375rem)] leading-[1.5]">
      {hero.sub}
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <Button href="#contatti">{hero.primaryCta}</Button>
      <Button href="#materiali" variant="secondary">
        {hero.secondaryCta}
      </Button>
    </div>
    {printers !== null && (
      <p class="bg-surface text-muted mt-8 inline-flex min-h-9 items-center gap-2.5 rounded-full px-4 text-[0.875rem]">
        <span class="live-dot bg-ok text-ok relative size-2 rounded-full" />
        <span>
          {badgeBefore}
          <span data-count-to={printers} class="text-fg font-semibold tabular-nums">
            {printers}
          </span>
          {badgeAfter}
        </span>
      </p>
    )}
  </Container>

  <Container class="mt-[clamp(3rem,6vw,5rem)]">
    <div class="grid items-end gap-5 md:grid-cols-[1fr_1.3fr_1fr]">
      {left && (
        <div class:list={[frame, 'hidden aspect-[4/5] md:block']}>
          <Photo src={left.src} alt={left.alt} sizes="(min-width: 75rem) 21rem, 28vw" parallax />
        </div>
      )}
      <!-- La foto centrale è il contenuto di base: src/scripts/print-stage.ts le sovrappone la scena di stampa dove WebGL regge -->
      {center && (
        <div
          data-print-stage
          data-objects={JSON.stringify(stageObjects)}
          class:list={[frame, 'print-stage relative aspect-[4/5] md:aspect-[3/4]']}
        >
          <div data-stage-fallback class="h-full w-full">
            <Photo
              src={center.src}
              alt={center.alt}
              sizes="(min-width: 75rem) 28rem, (min-width: 48rem) 38vw, 92vw"
              priority
              parallax
            />
          </div>
          <canvas
            data-stage-canvas
            hidden
            role="img"
            aria-label={stage.label}
            class="absolute inset-0 h-full w-full"
          />
          <div
            data-stage-hud
            hidden
            aria-hidden="true"
            class="stage-panel absolute inset-x-3 bottom-3 rounded-[1.25rem] px-4 pt-3 pb-3.5 text-left sm:inset-x-4 sm:bottom-4"
          >
            <p class="text-muted flex items-center gap-2 overflow-hidden text-[0.75rem] font-medium whitespace-nowrap">
              <span class="stage-dot size-1.5 shrink-0 rounded-full" />
              <span data-stage-status data-printing={stage.printing} data-done={stage.done}>
                {stage.printing}
              </span>
              <span>·</span>
              <span data-stage-material class="text-fg truncate">
                {stageObjects[0]?.materialName}
              </span>
            </p>
            <div class="mt-0.5 flex items-baseline justify-between gap-4">
              <p data-stage-name class="truncate text-[0.9375rem] leading-tight font-semibold">
                {stageObjects[0]?.name}
              </p>
              <p class="text-muted shrink-0 text-[0.75rem] tabular-nums">
                {stage.layer}{' '}
                <span data-stage-layer class="text-fg font-semibold">
                  000
                </span>
                {' / '}
                <span data-stage-total>300</span>
              </p>
            </div>
            <div class="bg-fg/10 mt-2.5 h-1 overflow-hidden rounded-full">
              <div data-stage-bar class="stage-bar bg-accent h-full rounded-full"></div>
            </div>
          </div>
          <button
            type="button"
            data-stage-toggle
            data-label-pause={stage.pause}
            data-label-play={stage.play}
            aria-label={stage.pause}
            hidden
            class="stage-panel text-fg group/toggle absolute top-3 right-3 inline-flex size-11 items-center justify-center rounded-full sm:top-4 sm:right-4"
          >
            <Icon name="pause" size={18} class="group-data-paused/toggle:hidden" />
            <Icon name="play" size={18} class="hidden group-data-paused/toggle:block" />
          </button>
        </div>
      )}
      {right && (
        <div class:list={[frame, 'hidden aspect-[4/5] md:block']}>
          <Photo src={right.src} alt={right.alt} sizes="(min-width: 75rem) 21rem, 28vw" parallax />
        </div>
      )}
    </div>

    <dl class="mx-auto mt-[clamp(3rem,6vw,5rem)] grid max-w-[56rem] gap-y-8 text-center sm:grid-cols-3">
      {hero.stats.map((stat) => (
        <div class="flex flex-col-reverse gap-1.5">
          <dt class="text-muted text-[0.9375rem]">{stat.label}</dt>
          <dd class="text-[clamp(2rem,3vw+1rem,3.25rem)] leading-none font-semibold tracking-[-0.035em] tabular-nums">
            {stat.value === null ? (
              stat.text
            ) : (
              <>
                {stat.prefix}
                <span data-count-to={stat.value}>{stat.value}</span>
                {stat.suffix}
              </>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </Container>
</section>
