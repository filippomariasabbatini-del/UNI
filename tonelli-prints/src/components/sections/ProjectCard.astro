---
import type { Project } from '../../lib/content';
import Photo from '../ui/Photo.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<li data-carousel-item class="w-[min(86vw,56rem)] shrink-0 snap-center">
  <figure class="rounded-panel bg-surface grid h-full overflow-hidden md:grid-cols-[0.9fr_1.1fr]">
    <div class="aspect-[4/3] overflow-hidden md:aspect-auto md:min-h-[28rem]">
      <Photo
        src={project.image.src}
        alt={project.image.alt}
        sizes="(min-width: 64rem) 25rem, (min-width: 48rem) 39vw, 86vw"
      />
    </div>
    <div class="flex flex-col justify-between gap-8 p-7 md:p-10">
      <p class="text-accent-text text-[0.9375rem] font-semibold">{project.title}</p>
      <blockquote class="text-[clamp(1.125rem,1.1vw+0.9rem,1.5rem)] leading-[1.4] font-medium tracking-[-0.015em]">
        <p>«{project.quote}»</p>
      </blockquote>
      <figcaption class="text-[0.9375rem]">
        <span class="font-semibold">{project.author}</span>
        <span class="text-muted block">{project.place}</span>
      </figcaption>
    </div>
  </figure>
</li>
