---
import type { Locale } from '../../config/site';
import { getContent, type Ui } from '../../lib/content';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import TeamCard from './TeamCard.astro';

interface Props {
  locale: Locale;
  ui: Ui;
}
const { locale, ui } = Astro.props;
const team = (await getContent('team', locale)).items;
---

<Section id="chi-siamo" labelledby="chi-siamo-title">
  <Container>
    <SectionHeader
      id="chi-siamo-title"
      eyebrow={ui.about.eyebrow}
      title={ui.about.title}
      sub={ui.about.body}
    />
    <ul class="mt-[clamp(3rem,6vw,5rem)] grid gap-6 md:grid-cols-3">
      {team.map((member, index) => (
        <TeamCard member={member} ui={ui} delay={index * 90} />
      ))}
    </ul>
  </Container>
</Section>
