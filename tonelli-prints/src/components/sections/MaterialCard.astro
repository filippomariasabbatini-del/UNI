---
import type { MaterialPricing } from '../../config/pricing';
import type { Material, Ui } from '../../lib/content';
import { format } from '../../lib/format';
import Heading from '../ui/Heading.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  material: Material;
  price: MaterialPricing;
  /** Prezzo a 100 unità già formattato, oppure null se manca il dato */
  formattedPrice: string | null;
  ui: Ui;
  delay: number;
}
const { material, price, formattedPrice, ui, delay } = Astro.props;
const labels = ui.materials;
const panelId = `scheda-${material.id}`;
---

<li data-reveal={delay} class="flex">
  <div
    data-material
    class="material-card rounded-card bg-raised shadow-card relative flex min-h-[14rem] sm:min-h-[18rem] w-full flex-col justify-between overflow-hidden p-7"
  >
    <div class="flex items-start justify-between gap-4">
      <p class="bg-surface rounded-full px-3.5 py-1.5 text-[0.875rem] font-medium">
        {material.tag}
      </p>
      <button
        type="button"
        aria-expanded="false"
        aria-controls={panelId}
        aria-label={format(labels.hint, { material: material.name })}
        class="material-toggle bg-surface relative z-10 -mt-1.5 -mr-1.5 inline-flex size-11 items-center justify-center rounded-full"
      >
        <Icon name="plus" />
      </button>
    </div>

    <Heading level={3} size="subtitle">
      {material.name}
    </Heading>

    <div
      id={panelId}
      class="material-panel tone-dark bg-surface text-fg absolute inset-0 flex flex-col justify-end p-7"
    >
      <p class="text-[1.25rem] font-semibold tracking-[-0.02em]">{material.name}</p>
      {material.specs === null ? (
        // Dati mancanti: completare src/content/materials/<lingua>.json e src/config/pricing.ts
        <p class="text-muted mt-2 text-[0.9375rem] leading-[1.5]">{labels.pending}</p>
      ) : (
        <>
          <p class="text-muted mt-2 text-[0.9375rem]">{material.specs}</p>
          {material.colors.length > 0 && (
            <ul aria-label={labels.colors} class="mt-4 flex flex-wrap gap-2">
              {material.colors.map((color) => (
                <li
                  data-swatch={color.hex}
                  title={color.name}
                  class="ring-line size-6 rounded-full ring-1"
                >
                  <span class="sr-only">{color.name}</span>
                </li>
              ))}
            </ul>
          )}
          <dl class="border-line mt-5 grid grid-cols-2 gap-4 border-t pt-5">
            {price.baseLeadDays !== null && (
              <div class="flex flex-col-reverse gap-1">
                <dt class="text-muted text-[0.875rem]">{labels.lead}</dt>
                <dd class="text-[1.375rem] font-semibold tracking-[-0.02em]">
                  {format(labels.days, { days: price.baseLeadDays })}
                </dd>
              </div>
            )}
            {formattedPrice !== null && (
              <div class="flex flex-col-reverse gap-1">
                <dt class="text-muted text-[0.875rem]">{labels.price}</dt>
                <dd class="text-[1.375rem] font-semibold tracking-[-0.02em]">{formattedPrice}</dd>
              </div>
            )}
          </dl>
        </>
      )}
    </div>
  </div>
</li>
