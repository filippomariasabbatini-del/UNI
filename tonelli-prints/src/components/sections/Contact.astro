---
import { site, type Locale } from '../../config/site';
import type { Ui } from '../../lib/content';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ContactForm from './ContactForm.astro';

interface Props {
  locale: Locale;
  ui: Ui;
}
const { locale, ui } = Astro.props;
---

<Section id="contatti" labelledby="contatti-title">
  <Container class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
    <div>
      <SectionHeader id="contatti-title" eyebrow={ui.contact.eyebrow} title={ui.contact.title} />
      <p
        data-reveal
        class="text-muted mt-6 text-[clamp(1.125rem,0.6vw+1rem,1.3125rem)] leading-[1.5]"
      >
        {ui.contact.noteBefore}{' '}
        <a
          href={`mailto:${site.email}`}
          class="text-accent-text underline underline-offset-[0.2em]"
        >
          {site.email}
        </a>
        {ui.contact.noteAfter}
      </p>
    </div>
    <div data-reveal="90">
      <ContactForm locale={locale} ui={ui} />
    </div>
  </Container>
</Section>
