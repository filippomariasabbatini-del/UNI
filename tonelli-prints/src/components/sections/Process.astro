---
import type { Locale } from '../../config/site';
import { getContent, type Ui } from '../../lib/content';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  locale: Locale;
  ui: Ui;
}
const { locale, ui } = Astro.props;
const steps = (await getContent('process', locale)).items;
---

<Section id="processo" labelledby="processo-title">
  <Container>
    <SectionHeader
      id="processo-title"
      eyebrow={ui.process.eyebrow}
      title={ui.process.title}
      sub={ui.process.sub}
    />
    <ol class="mt-[clamp(3rem,6vw,5rem)] grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, index) => (
        <li data-reveal={index * 90} class="border-fg border-t-2 pt-6">
          <p
            aria-hidden="true"
            class="text-accent-text text-[0.9375rem] font-semibold tabular-nums"
          >
            {String(index + 1).padStart(2, '0')}
          </p>
          <Heading level={3} size="card" class="mt-3">
            {step.title}
          </Heading>
          <p class="text-muted mt-3 text-[0.9375rem] leading-[1.55]">{step.description}</p>
        </li>
      ))}
    </ol>
  </Container>
</Section>
