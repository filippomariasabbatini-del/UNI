---
import type { Studio } from '../../config/site';
import type { StudioContent, Ui } from '../../lib/content';
import { format } from '../../lib/i18n';
import Card from '../ui/Card.astro';
import Heading from '../ui/Heading.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  studio: Studio;
  content: StudioContent;
  ui: Ui;
  delay: number;
}
const { studio, content, ui, delay } = Astro.props;
---

<li data-reveal={delay} class="flex">
  <Card class="flex w-full flex-col p-8 md:p-10">
    <p class="text-accent-text text-[0.9375rem] font-semibold">{content.label}</p>
    <Heading level={3} size="title" class="mt-2">
      {content.city}
    </Heading>
    <p class="text-muted mt-5 max-w-[30rem] leading-[1.55]">{content.description}</p>
    {content.addressLine && <p class="mt-4 text-[0.9375rem]">{content.addressLine}</p>}

    <!-- Ora locale e stato: riempiti da src/scripts/studio-clock.ts con gli orari di site.ts -->
    <p
      data-studio-clock
      data-time-zone={studio.timeZone}
      data-week={JSON.stringify(studio.hours.week)}
      hidden
      class="border-line mt-8 flex flex-wrap items-center gap-x-4 gap-y-1 border-t pt-6 text-[0.9375rem]"
    >
      <span class="inline-flex items-baseline gap-1.5">
        <span class="text-muted">{ui.studios.localTime}</span>
        <time data-studio-time class="font-semibold tabular-nums"></time>
      </span>
      <span class="inline-flex items-center gap-2">
        <span
          data-studio-dot
          aria-hidden="true"
          class="bg-muted data-open:bg-ok size-2 rounded-full"
        ></span>
        <span data-studio-status></span>
      </span>
    </p>

    <a
      href={`tel:${studio.phone}`}
      aria-label={`${format(ui.studios.call, { city: content.city })}: ${studio.phoneDisplay}`}
      class="hover:text-accent-text mt-auto inline-flex min-h-11 items-center gap-2.5 self-start pt-6 text-[1.25rem] font-semibold tracking-[-0.015em] transition-colors"
    >
      <Icon name="phone" />
      {studio.phoneDisplay}
    </a>
  </Card>
</li>
