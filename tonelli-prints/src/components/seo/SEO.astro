---
import { site, type Locale } from '../../config/site';
import { INTL_LOCALE, absoluteUrl, alternates, localePath } from '../../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Percorso senza prefisso di lingua, es. "/" oppure "/privacy.html" */
  path: string;
  imageAlt: string;
  noindex?: boolean;
}
const { locale, title, description, path, imageAlt, noindex = false } = Astro.props;
const canonical = absoluteUrl(localePath(locale, path));
const image = absoluteUrl('/og-image.png');
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
{!noindex && (
  <>
    <link rel="canonical" href={canonical} />
    {alternates(path).map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
  </>
)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={INTL_LOCALE[locale].replace('-', '_')} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
