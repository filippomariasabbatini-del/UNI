---
interface Props {
  level: 1 | 2 | 3;
  size?: 'display' | 'title' | 'subtitle' | 'card';
  id?: string;
  class?: string;
}
const { level, size = 'title', id, class: className } = Astro.props;
const Tag = `h${level}` as const;
const sizes = {
  display: 'text-[clamp(2.5rem,6.2vw+0.6rem,5rem)] leading-[1.04] tracking-[-0.035em]',
  title: 'text-[clamp(2rem,4vw+0.75rem,3.5rem)] leading-[1.08] tracking-[-0.03em]',
  subtitle: 'text-[clamp(1.5rem,2vw+0.75rem,2rem)] leading-[1.15] tracking-[-0.025em]',
  card: 'text-[1.375rem] leading-[1.2] tracking-[-0.02em]',
};
---

<Tag id={id} class:list={['font-semibold', sizes[size], className]}>
  <slot />
</Tag>
