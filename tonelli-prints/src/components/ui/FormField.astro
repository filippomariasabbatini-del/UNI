---
interface Props {
  /** id del controllo: l'errore ha id `${id}-error` e va referenziato con aria-describedby */
  id: string;
  label: string;
  class?: string;
}
const { id, label, class: className } = Astro.props;
---

<div class={className}>
  <label for={id} class="mb-2 block text-[0.9375rem] font-medium">
    {label}
  </label>
  <slot />
  <p id={`${id}-error`} data-error-for={id} class="text-danger mt-2 text-[0.9375rem]" hidden></p>
</div>
