{
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "paper-alt": {
      "$type": "color",
      "$value": "#f7f6f2"
    },
    "line": {
      "$type": "color",
      "$value": "#d9d6cc"
    },
    "ink": {
      "$type": "color",
      "$value": "#0a192f"
    },
    "ink-raised": {
      "$type": "color",
      "$value": "#112240"
    },
    "ink-muted": {
      "$type": "color",
      "$value": "#3b4451"
    },
    "gold": {
      "$type": "color",
      "$value": "#b8935a"
    },
    "gold-strong": {
      "$type": "color",
      "$value": "#8a6a35"
    },
    "signal": {
      "$type": "color",
      "$value": "#1d4ed8"
    },
    "signal-strong": {
      "$type": "color",
      "$value": "#1e3a8a"
    }
  },
  "gradient": {
    "hero-glow": {
      "$type": "string",
      "$value": "radial-gradient(55% 75% at 82% 42%, rgb(29 78 216 / 0.07), transparent 70%), radial-gradient(35% 45% at 64% 78%, rgb(184 147 90 / 0.08), transparent 70%)",
      "$description": "CSS gradient; rebuild as a Figma paint style"
    },
    "navy": {
      "$type": "string",
      "$value": "radial-gradient(70% 140% at 100% 0%, rgb(184 147 90 / 0.16), transparent 60%), linear-gradient(135deg, #0a192f 0%, #112240 100%)",
      "$description": "CSS gradient; rebuild as a Figma paint style"
    },
    "surface": {
      "$type": "string",
      "$value": "linear-gradient(180deg, #f7f6f2 0%, #ffffff 100%)",
      "$description": "CSS gradient; rebuild as a Figma paint style"
    },
    "rule": {
      "$type": "string",
      "$value": "linear-gradient(90deg, #b8935a 0%, rgb(184 147 90 / 0) 100%)",
      "$description": "CSS gradient; rebuild as a Figma paint style"
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Inter Variable",
        "Roboto",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Montserrat Variable",
        "Inter Variable",
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": "160ms"
    },
    "tactical": {
      "$type": "duration",
      "$value": "180ms"
    },
    "base": {
      "$type": "duration",
      "$value": "320ms"
    },
    "reveal": {
      "$type": "duration",
      "$value": "640ms"
    },
    "focus": {
      "$type": "duration",
      "$value": "800ms"
    }
  },
  "easing": {
    "institutional": {
      "$type": "cubicBezier",
      "$value": [
        0.22,
        1,
        0.36,
        1
      ]
    },
    "focus": {
      "$type": "cubicBezier",
      "$value": [
        0.33,
        1,
        0.68,
        1
      ]
    },
    "out-quart": {
      "$type": "cubicBezier",
      "$value": [
        0.25,
        1,
        0.5,
        1
      ]
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "2px"
    },
    "md": {
      "$type": "dimension",
      "$value": "4px"
    }
  },
  "stroke": {
    "icon": {
      "$type": "dimension",
      "$value": "1.5px"
    }
  }
}
