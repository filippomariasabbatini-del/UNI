{
  "name": "valkyrien-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Valkyrien Holding Ltd - corporate site (valkyrien.co.uk)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "check:contrast": "node tools/contrast-check.mjs",
    "images": "node tools/optimize-images.mjs",
    "compliance:build": "bash compliance-docs/build.sh",
    "verify": "npm run check:contrast && npm run build && npm run lint:html",
    "tokens": "node tools/export-tokens.mjs",
    "logo": "python3 tools/build-logo.py",
    "audit:ui": "node tools/ui-audit.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "axe-core": "4.10.3",
    "html-validate": "11.21.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "vite": "6.4.6"
  }
}
